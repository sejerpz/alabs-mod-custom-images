#!/bin/bash
PLATFORM=$1

# source global configs
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/config.sh"

# check if the docker container is running
source local.env $PLATFORM

# build dependencies
if ! pkg-config --exists cc_client; then
    # build the cc-master library
    echo "Building cc-master library since it is not found in the system"
    cd $DOCKER_SRC_ROOT/deps/cc-master
    if pkg-config cc_client; then
        echo "uninstalling cc-master"
        ./waf uninstall || echo "Failed to uninstall cc-master, continuing with build";
    fi
    ./waf configure --prefix=/usr || { echo "Failed to configure cc-master"; exit 1; }
    ./waf build || { echo "Failed to build cc-master"; exit 1; }
    ./waf install --destdir=$STAGING_DIR || { echo "Failed to install cc-master"; exit 1; }
    cd $DOCKER_SRC_ROOT
fi

# check if the dependencies are installed
echo -n
if pkg-config --exists cc_client; then
    echo "cc_client...: found"
else
    echo "cc_client...: not found (use build-deps parameter to rebuild and install cc-master)"
    exit 1
fi
if pkg-config --exists hylia; then
    echo "hylia.......: found"
else
    echo "hylia.......: not found"
    exit 1
fi
if pkg-config --exists fftw3 fftw3f; then
    echo "fftw3.......: found"
else
    echo "fftw3.......: not found"
    exit 1
fi


echo -n
# build the modtools library
echo "Building modtools library" 
make -C mod-ui/utils clean
make -C mod-ui/utils

# build mod-host
echo "Building mod-host"
# build mod-host
make -C mod-host clean
make -C mod-host || { echo "Failed to build mod-host"; exit 1; }

# build mod-system-control
echo "Building mod-system-control"
# against the libsystemd create-image takes from the base image, so it notifies systemd
# (Type=notify) as the official build does; the build environment has none
#  - flags by hand, not a .pc: the pkg-config of the build environment prefixes every
#    -I and -L with its sysroot
#  - -lsystemd last, after the objects, or --as-needed drops it
SYSTEMD_LIB_DIR=$DOCKER_SRC_ROOT/deps/libsystemd-$PLATFORM/lib
make -C mod-system-control clean
make -C mod-system-control \
	CFLAGS="$CFLAGS -DHAVE_SYSTEMD -I$DOCKER_SRC_ROOT/third-party/systemd/include" \
	LINK_FLAGS_SD="-L$SYSTEMD_LIB_DIR -Wl,-rpath-link,$SYSTEMD_LIB_DIR -lsystemd" \
	|| { echo "Failed to build mod-system-control"; exit 1; }

# build the libcrypto of the Duo (see config.sh), downloaded by create-image
#  - the Configure of the buildroot 2016.02 of the image (package/openssl), plus -marm:
#    the ARM assembly of OpenSSL 1.0.2 is wrong when built as Thumb-2, the default of the toolchain
#  - serial make: OpenSSL 1.0.2 does not build in parallel without the patches of buildroot
#  - no "make depend": the environment has no makedepend, and the tree is always a fresh one
#  - the ABI does not change, the image keeps its libssl
if [ $PLATFORM = "modduo-new" ] && [ -n "$ALABS_OPENSSL_SHA256" ]; then
	echo "Building libcrypto of OpenSSL $ALABS_OPENSSL_VERSION"
	OPENSSL_OUT=$DOCKER_SRC_ROOT/deps/openssl-$PLATFORM
	OPENSSL_BUILD=$(mktemp -d)
	rm -rf $OPENSSL_OUT
	tar -xzf $DOCKER_SRC_ROOT/deps/openssl-$ALABS_OPENSSL_VERSION.tar.gz -C $OPENSSL_BUILD \
		|| { echo "Failed to extract OpenSSL"; exit 1; }
	(cd $OPENSSL_BUILD/openssl-$ALABS_OPENSSL_VERSION && \
		CC=$CC ./Configure linux-armv4 --prefix=/usr --openssldir=/etc/ssl \
			threads shared no-rc5 enable-camellia enable-mdc2 enable-tlsext zlib-dynamic \
			-D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -O3 -marm && \
		make CC=$CC AR="${BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX}-ar r" RANLIB=$RANLIB build_libs && \
		$STRIP --strip-unneeded libcrypto.so.1.0.0) > $OPENSSL_BUILD/build.log 2>&1 \
		|| { tail -20 $OPENSSL_BUILD/build.log; echo "Failed to build OpenSSL"; exit 1; }
	mkdir -p $OPENSSL_OUT
	cp $OPENSSL_BUILD/openssl-$ALABS_OPENSSL_VERSION/libcrypto.so.1.0.0 $OPENSSL_OUT/
	rm -rf $OPENSSL_BUILD
fi

